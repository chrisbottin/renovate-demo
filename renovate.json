{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": ["main", "DD34"],
  "packageRules": [
    {
      "description": "Split patch and minor updates",
      "matchBaseBranches": ["main", "DD34"],
      "separateMinorPatch": true
    }, 
    {
      "matchBaseBranches": ["main", "DD34"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    }
  ]
}
